# Set a random secret in .env.local as shown in README.md.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=phish_out

# See sandbox/README.md. Set the secret only in .env.local.
SANDBOX_URL=
SANDBOX_SECRET=

# Optional server-side Gemini integration for /admin practice drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Auth emails. Use starttls (usually 587) or tls (usually 465).
SYSTEM_EMAIL_FROM=
SYSTEM_SMTP_HOST=
SYSTEM_SMTP_PORT=587
SYSTEM_SMTP_SECURITY=starttls
SYSTEM_SMTP_USER=
SYSTEM_SMTP_PASSWORD=

# Optional custom prediction model (see model/README.md). Without it, a built-in baseline runs.
PREDICTION_MODEL_URL=
PREDICTION_MODEL_TOKEN=

# Where uploaded profile photos are stored. Defaults to ./.data/uploads.
UPLOAD_DIR=

# Terminal forensics service (sandbox/terminal). Locally: http://127.0.0.1:8788
TERMINAL_URL=
